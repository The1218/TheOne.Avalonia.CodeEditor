<Styles
    x:Class="TheOne.Avalonia.Themes.CodeEditorTheme"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TheOne.Avalonia.CodeEditor/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodeEditor.GutterForeground">#717979</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.CurrentLineBackground">#E8F4F4</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Keyword">#174EAE</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.String">#98431A</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Comment">#586F59</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Number">#A0362C</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Type">#006061</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticType">#006061</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticMethod">#69449B</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticField">#7E3E69</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticProperty">#7E3E69</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticParameter">#835016</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Punctuation">#465050</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Escape">#9B2F61</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Regex">#8D3C57</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Tag">#174EAE</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Attribute">#7E3E69</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Function">#69449B</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Preprocessor">#735214</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Heading">#174EAE</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Fence">#586F59</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Interpolation">#69449B</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodeEditor.GutterForeground">#A4ACAC</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.CurrentLineBackground">#1D3131</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Keyword">#90B9F7</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.String">#ECB28B</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Comment">#A1BD97</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Number">#F0A59E</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Type">#63D9DE</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticType">#63D9DE</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticMethod">#C8AAFA</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticField">#E7AED4</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticProperty">#E7AED4</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.SemanticParameter">#E9C08A</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Punctuation">#D2DDDD</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Escape">#F2A6CD</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Regex">#E8A7B9</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Tag">#90B9F7</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Attribute">#E7AED4</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Function">#C8AAFA</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Preprocessor">#E9C08A</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Heading">#90B9F7</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Fence">#A1BD97</SolidColorBrush>
                    <SolidColorBrush x:Key="CodeEditor.Interpolation">#C8AAFA</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ControlTheme TargetType="one:CodeEditor" x:Key="{x:Type one:CodeEditor}">
                <Setter Property="Background" Value="{DynamicResource CodeEditor.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource CodeEditor.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CodeEditor.InputLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="100" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                ClipToBounds="True"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="{TemplateBinding BorderThickness}">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border
                                        Background="{DynamicResource CodeEditor.SurfaceHover}"
                                        BorderBrush="{DynamicResource CodeEditor.InputLine}"
                                        BorderThickness="0,0,0,1"
                                        Grid.Row="0"
                                        Padding="10,3"
                                        x:Name="PART_Header">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <ContentPresenter
                                                Content="{TemplateBinding Header}"
                                                Margin="0,0,12,0"
                                                TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                                VerticalAlignment="Center" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                                <PathIcon
                                                    Data="M3,7 V4 A3,3 0 0 1 9,4 V7 M1,7 H11 V14 H1 Z M6,10 V12"
                                                    Foreground="{DynamicResource CodeEditor.Muted}"
                                                    Height="11"
                                                    Width="11"
                                                    x:Name="PART_Lock" />
                                                <TextBlock
                                                    FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource CodeEditor.Muted}"
                                                    Text="可编辑"
                                                    VerticalAlignment="Center"
                                                    x:Name="PART_Mode" />
                                            </StackPanel>
                                            <Button
                                                AutomationProperties.Name="复制全部 / Copy all"
                                                Classes="one-editor-button one-code-action"
                                                Command="{Binding CopyAllCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Grid.Column="2"
                                                IsVisible="{TemplateBinding ShowCopyButton}"
                                                Margin="6,0,0,0"
                                                ToolTip.Tip="复制全部 / Copy all"
                                                x:Name="PART_CopyButton">
                                                <PathIcon
                                                    Data="M5,1 H13 V11 H10 V4 H5 Z M1,5 H9 V15 H1 Z"
                                                    Height="11"
                                                    Width="11" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="格式化代码 / Format code"
                                                Classes="one-editor-button one-code-action"
                                                Command="{Binding FormatCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Grid.Column="3"
                                                IsVisible="{TemplateBinding ShowFormatButton}"
                                                Margin="4,0,0,0"
                                                ToolTip.Tip="格式化 / Format · Alt+Shift+F"
                                                x:Name="PART_FormatButton">
                                                <PathIcon
                                                    Data="M4,2 L0,7 L4,12 M10,2 L14,7 L10,12 M8,0 L6,14"
                                                    Height="11"
                                                    Width="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ContentControl
                                        Grid.Row="1"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        x:Name="PART_EditorHost" />
                                    <Border
                                        Background="{DynamicResource CodeEditor.SurfaceHover}"
                                        BorderBrush="{DynamicResource CodeEditor.InputLine}"
                                        BorderThickness="0,1,0,0"
                                        Grid.Row="2"
                                        IsVisible="{TemplateBinding ShowStatusBar}"
                                        MinHeight="28"
                                        Padding="10,3"
                                        x:Name="PART_StatusBar">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                            TextElement.FontSize="12"
                                            TextElement.Foreground="{DynamicResource CodeEditor.Muted}">
                                            <Grid
                                                ColumnDefinitions="Auto,Auto,*,Auto"
                                                ColumnSpacing="6"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    LineHeight="18"
                                                    Text="{Binding LanguageName, RelativeSource={RelativeSource TemplatedParent}}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"
                                                    x:Name="PART_Language" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    IsVisible="{TemplateBinding IsReadOnly}"
                                                    LineHeight="18"
                                                    Text="只读"
                                                    VerticalAlignment="Center"
                                                    x:Name="PART_ReadOnlyStatus" />
                                                <Button
                                                    AutomationProperties.Name="{Binding DiagnosticDetail, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Classes="one-editor-button one-code-link"
                                                    Command="{Binding GoToDiagnosticCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Cursor="Hand"
                                                    Foreground="{DynamicResource CodeEditor.Danger}"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    MinWidth="0"
                                                    Padding="1,0"
                                                    x:Name="PART_Diagnostics">
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <ContentPresenter
                                                                Background="Transparent"
                                                                Content="{TemplateBinding Content}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Padding="1,0"
                                                                VerticalContentAlignment="Center" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid
                                                        ColumnDefinitions="Auto,Auto,*"
                                                        ColumnSpacing="4"
                                                        VerticalAlignment="Center">
                                                        <PathIcon
                                                            Data="F0 M7,0 A7,7 0 1 1 7,14 A7,7 0 1 1 7,0 M6,3 V8 H8 V3 Z M6,10 V12 H8 V10 Z"
                                                            Foreground="{DynamicResource CodeEditor.Danger}"
                                                            Height="10"
                                                            VerticalAlignment="Center"
                                                            Width="10"
                                                            x:Name="PART_ErrorIcon" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Normal"
                                                            Grid.Column="1"
                                                            LineHeight="18"
                                                            Text="{Binding DiagnosticLine, RelativeSource={RelativeSource TemplatedParent}}"
                                                            VerticalAlignment="Center"
                                                            x:Name="PART_ErrorLine" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Normal"
                                                            Grid.Column="2"
                                                            LineHeight="18"
                                                            Text="{Binding DiagnosticMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center"
                                                            x:Name="PART_ErrorMessage" />
                                                    </Grid>
                                                </Button>
                                                <TextBlock
                                                    Foreground="{DynamicResource CodeEditor.Danger}"
                                                    Grid.Column="3"
                                                    LineHeight="18"
                                                    MaxWidth="120"
                                                    Text="{Binding FormattingError, RelativeSource={RelativeSource TemplatedParent}}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding FormattingError, RelativeSource={RelativeSource TemplatedParent}}"
                                                    VerticalAlignment="Center"
                                                    x:Name="PART_FormattingError" />
                                            </Grid>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Orientation="Horizontal"
                                                Spacing="3"
                                                VerticalAlignment="Center"
                                                x:Name="PART_Position">
                                                <TextBlock
                                                    FontSize="12"
                                                    LineHeight="18"
                                                    VerticalAlignment="Center"
                                                    x:Name="PART_PositionText">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="行 {0}，列 {1}">
                                                            <Binding Path="CaretLine" RelativeSource="{RelativeSource TemplatedParent}" />
                                                            <Binding Path="CaretColumn" RelativeSource="{RelativeSource TemplatedParent}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <!--  Keep the single outline above header, editor and status backgrounds.  -->
                            <Border
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                x:Name="PART_Border" />
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:small">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="6,8" />
                </Style>
                <Style Selector="^:large">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Padding" Value="10,12" />
                </Style>
                <Style Selector="^ /template/ Button.one-editor-button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="3" />
                </Style>
                <Style Selector="^ /template/ Button.one-code-action">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="^ /template/ Button.one-code-link">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Padding" Value="1,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="^ /template/ Button.one-code-link:pointerover TextBlock">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Style>
                <Style Selector="^:focus-within /template/ Border#PART_Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource CodeEditor.Accent}" />
                </Style>
                <Style Selector="^ /template/ Border#PART_Header">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:has-header /template/ Border#PART_Header">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^ /template/ PathIcon#PART_Lock">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:readonly /template/ PathIcon#PART_Lock">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:readonly /template/ TextBlock#PART_Mode">
                    <Setter Property="Text" Value="只读" />
                </Style>
                <Style Selector="^ /template/ Button#PART_Diagnostics">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:has-diagnostics /template/ Button#PART_Diagnostics">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^ /template/ TextBlock#PART_FormattingError">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:format-error /template/ TextBlock#PART_FormattingError">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
    <FluentTheme />
</Styles>